# Copy this file to .env and replace each placeholder with unique local values before startup.

# A ZAP API key is only needed when ZAP_ENABLED=true.
ZAP_ENABLED=false
ZAP_API_KEY=
ZAP_SCAN_POLICY=
ZAP_ATTACK_STRENGTH=High
ZAP_ALERT_THRESHOLD=Low
ZAP_ENABLE_ALL_SCANNERS=true
ZAP_AJAX_SPIDER_ENABLED=true

# Required for JWT signing. Generate a strong random value and keep it private.
JWT_SECRET_KEY=

# Keep authentication required for deployments. Set false only for local open access.
AUTH_REQUIRED=true
PUBLIC_REGISTRATION_ENABLED=false

# Bootstrap account. Enable explicitly and set a unique password before first startup.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=local-admin@example.invalid
SEED_ADMIN_PASSWORD=

# Optional synthetic demo assets and findings; independent of bootstrap account creation.
SEED_DEMO_DATA_ENABLED=false

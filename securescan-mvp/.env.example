# Copy this file to .env and replace each placeholder with unique values before starting the backend.

JWT_SECRET_KEY=
AUTH_REQUIRED=true
PUBLIC_REGISTRATION_ENABLED=false

# Bootstrap account. Enable explicitly and set a unique password before first startup.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=local-admin@example.invalid
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA_ENABLED=false

# Rate limiting
SCAN_RATE_LIMIT_PER_HOUR=20

# Optional OWASP ZAP active scanning; only scan assets you are authorized to test.
ZAP_ENABLED=false
ZAP_API_URL=http://127.0.0.1:8080
# Required only when ZAP_ENABLED=true.
ZAP_API_KEY=
ZAP_SCAN_POLICY=
ZAP_ATTACK_STRENGTH=High
ZAP_ALERT_THRESHOLD=Low
ZAP_ENABLE_ALL_SCANNERS=true
